{
  "name": "@okize/oxlint-config",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "description": "My preferred oxlint rule settings bundled into composable configs",
  "files": [
    "/configs",
    "/rules",
    "/plugins",
    "/index.mjs",
    "/index.d.mts",
    "/oxfmtConfig.mjs",
    "/oxfmtConfig.d.mts",
    "/resolve-plugin.mjs"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./javascript": "./configs/javascript.mjs",
    "./typescript": "./configs/typescript.mjs",
    "./react": "./configs/react.mjs",
    "./node": "./configs/node.mjs",
    "./vitest": "./configs/vitest.mjs",
    "./playwright": "./configs/playwright.mjs",
    "./storybook": "./configs/storybook.mjs",
    "./styled-components": "./configs/styled-components.mjs",
    "./testing-library": "./configs/testing-library.mjs",
    "./oxfmtConfig": {
      "types": "./oxfmtConfig.d.mts",
      "default": "./oxfmtConfig.mjs"
    },
    "./rules/barrel-files": "./rules/barrel-files.mjs",
    "./rules/base": "./rules/base.mjs",
    "./rules/import": "./rules/import.mjs",
    "./rules/node": "./rules/node.mjs",
    "./rules/playwright": "./rules/playwright.mjs",
    "./rules/promise": "./rules/promise.mjs",
    "./rules/react-a11y": "./rules/react-a11y.mjs",
    "./rules/react": "./rules/react.mjs",
    "./rules/storybook": "./rules/storybook.mjs",
    "./rules/styled-components": "./rules/styled-components.mjs",
    "./rules/testing-library": "./rules/testing-library.mjs",
    "./rules/typescript": "./rules/typescript.mjs",
    "./rules/unicorn": "./rules/unicorn.mjs",
    "./rules/vitest": "./rules/vitest.mjs"
  },
  "scripts": {
    "changeset": "changeset",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:ci": "oxfmt -c oxfmt.config.mjs --check .",
    "outdated": "yarn upgrade-interactive",
    "release": "changeset publish",
    "test": "vitest run --exclude test/validate-configs.test.mjs",
    "validate": "vitest run test/validate-configs.test.mjs"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.17.1",
    "@vitest/eslint-plugin": "^1.6.23",
    "confusing-browser-globals": "^1.0.11",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-storybook": "^10.5.2",
    "eslint-plugin-styled-components": "^0.0.0",
    "eslint-plugin-styled-components-a11y": "^2.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "eslint": "^10.7.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "storybook": "^10.5.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "eslint": ">= 10.7.0",
    "oxfmt": ">= 0.59.0",
    "oxlint": ">= 1.74.0",
    "oxlint-tsgolint": ">= 0.25.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24 || >=26"
  },
  "keywords": [
    "oxlint",
    "oxlint-config",
    "linter",
    "typescript"
  ],
  "homepage": "https://github.com/okize/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/okize/oxlint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okize/oxlint-config.git"
  },
  "license": "MIT",
  "author": "Morgan Wigmanich"
}
